# Copy to `.env` and adjust. Real environment variables take precedence.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite per project decision)
SQLITE_DB_NAME=db.sqlite3

# Site: absolute base URL used for clickable links inside emails (localhost in dev)
SITE_BASE_URL=https://africancitiesexperts.org

# Logging (console is always on; files are disabled during tests)
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_DIR=logs
LOG_TO_FILE=True
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_SKIP_PATHS=/static/,/media/,/favicon.ico

# Email
EMAIL_HOST=
EMAIL_HOST_PASSWORD=
EMAIL_HOST_USER=
EMAIL_PORT=
EMAIL_TIMEOUT=20
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_BACKEND=